# =============================================================
# DaiMart - Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya
# cp .env.example .env.local
# =============================================================

# ─── Supabase ────────────────────────────────────────────────
# Ambil dari: Supabase Dashboard → Project Settings → API

# URL project Supabase kamu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key (aman untuk di-expose ke browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Service Role key (RAHASIA! Hanya untuk server-side)
# JANGAN commit nilai aslinya ke git
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=DaiMart
NEXT_PUBLIC_APP_URL=https://daimart.vercel.app
